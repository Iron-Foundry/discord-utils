# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

DISCORD_TOKEN=
GUILD_ID=

# PostgreSQL connection string
DATABASE_URL=

# Role IDs for permission checks.
STAFF_ROLE_ID=
SENIOR_STAFF_ROLE_ID=

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------

# Valkey/Redis connection string. Defaults to redis://localhost:6379.
VALKEY_URI=

# Set to true to enable debug logging.
DEBUG_MODE=

# ---------------------------------------------------------------
# Music (optional - leave MUSIC_BOT_TOKENS blank to disable)
# ---------------------------------------------------------------

# Comma-separated player bot tokens, max 5. The count IS the pool size.
# Each needs its own Discord application, with only Connect + Speak.
MUSIC_BOT_TOKENS=

# Lavalink node. Defaults to http://localhost:2333.
LAVALINK_URI=
LAVALINK_PASSWORD=

# Saved playlists are read from api-backend. Both are needed, or the playlist
# controls are simply absent - playback works without them.
# METRICS_API_KEY is the shared service key, managed by Infisical.
API_BACKEND_URL=
METRICS_API_KEY=
