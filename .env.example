# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

DISCORD_TOKEN=
GUILD_ID=

# PostgreSQL connection string
DATABASE_URL=

# Role IDs for permission checks.
STAFF_ROLE_ID=
SENIOR_STAFF_ROLE_ID=

